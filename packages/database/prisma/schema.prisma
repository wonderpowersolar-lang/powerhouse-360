// Powerhouse 360 — first migration (WP-1.1).
// Scope: identity core + CRM lead + platform (audit + domain-event outbox).
// Aligned with docs/POWERHOUSE_360_MASTER_PLAN.md §5 (Datenmodell). Auth tables
// (User/Session/…) arrive in WP-1.2 via better-auth; roles/property tree in WP-1.2/1.3.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  // native = local dev (macOS); debian-openssl-3.0.x = node:20-slim runtime image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

enum OrganizationType {
  POWERHOUSE
  PROPERTY_MANAGER
  WEG
  OWNER
  ASSET_HOLDER
  COOPERATIVE
  UTILITY
  INSTALLER_PARTNER
  OTHER
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  type      OrganizationType
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  leads       Lead[]
  auditEvents AuditEvent[]
  memberships OrganizationMembership[]
  invitations Invitation[]
  properties   Property[]
  accessScopes AccessScope[]

  @@map("organization")
}

// ---------------------------------------------------------------------------
// crm
// ---------------------------------------------------------------------------

enum LeadType {
  DEMO_REQUEST
  PROJECT_REQUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum ModuleKey {
  POWERMIETER
  HEATMIETER
  CHARGEMIETER
  SMOKEMIETER
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  NOTE
  CONTACTED
  NOTIFICATION_SENT
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  leadType LeadType
  status   LeadStatus @default(NEW)

  // Contact
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  role      String? // roleOrOrganizationType from the funnel

  // Qualification snapshot
  modules             ModuleKey[]
  dwellingUnits       String? // band, e.g. "20-49"
  buildings           Int?
  portfolioSize       Int?
  currentSituation    String?
  recommendedNextStep String?

  // Origin
  source       String? // "demo" | "projekt-besprechen"
  sourceModule ModuleKey? // from ?modul= (future funnel wiring)
  sourceTheme  String? // from ?thema=

  consentPrivacy Boolean
  consentContact Boolean

  // Lossless original payload for audit/replay.
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]

  @@index([status, createdAt])
  @@index([email])
  @@map("lead")
}

model LeadActivity {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type      LeadActivityType
  message   String?
  actorType AuditActorType   @default(SYSTEM)
  actorId   String?          @db.Uuid
  payload   Json?
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activity")
}

// ---------------------------------------------------------------------------
// platform: audit + domain-event outbox
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  WEBHOOK
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  actorType   AuditActorType @default(SYSTEM)
  actorId     String? // better-auth user id (non-UUID) or null for SYSTEM/WEBHOOK
  action      String // e.g. "lead.created"
  subjectType String // e.g. "Lead"
  subjectId   String
  before      Json?
  after       Json?
  requestId   String?
  createdAt   DateTime       @default(now())

  @@index([subjectType, subjectId])
  @@index([createdAt])
  @@map("audit_event")
}

enum DomainEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

/// Transactional outbox. Written in the same transaction as the state change;
/// drained by apps/worker. See docs/POWERHOUSE_360_MASTER_PLAN.md §3 + ADR-001.
model DomainEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String // e.g. "lead.created"
  aggregateType String // e.g. "Lead"
  aggregateId   String
  organizationId String?          @db.Uuid
  payload       Json
  status        DomainEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  processedAt   DateTime?
  lastError     String?
  correlationId String?
  causationId   String?
  createdAt     DateTime          @default(now())

  @@index([status, availableAt])
  @@map("domain_event")
}

// ---------------------------------------------------------------------------
// identity — auth tables (managed by better-auth; String ids, NOT @db.Uuid)
// ---------------------------------------------------------------------------
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  locale        String   @default("de") // additionalField
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships OrganizationMembership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // scrypt hash for email+password
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// rbac — tenancy + roles (our own models; @db.Uuid ids)
// ---------------------------------------------------------------------------
enum SystemRole {
  PLATFORM_ADMIN
  SALES
  OPERATIONS
  SERVICE
  FINANCE
  PROPERTY_MANAGER
  OWNER_BOARD
  BILLING_CONTACT
  INSTALLER_PARTNER_ADMIN
  INSTALLER
  RESIDENT
  PARKING_USER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  role           SystemRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_membership")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  email          String
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  role           SystemRole
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([email])
  @@index([organizationId, status])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// immobilien — Objektbaum-Kern (WP-1.3-Kern; Spec §3.1 Kunden-App-Architekturplan)
// Floor/Room/TechnicalRoom/GridConnection folgen mit dem WP-1.3-Rest.
// ---------------------------------------------------------------------------

model Address {
  id          String @id @default(uuid()) @db.Uuid
  street      String
  houseNumber String
  postalCode  String
  city        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildings Building[]

  @@map("address")
}

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  buildings    Building[]
  accessScopes AccessScope[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("property")
}

model Building {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  addressId  String   @db.Uuid
  address    Address  @relation(fields: [addressId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entrances    Entrance[]
  units        Unit[]
  accessScopes AccessScope[]

  @@unique([propertyId, name])
  @@map("building")
}

model Entrance {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @db.Uuid
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  label      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  units Unit[]

  @@unique([buildingId, label])
  @@map("entrance")
}

model Unit {
  id         String    @id @default(uuid()) @db.Uuid
  buildingId String    @db.Uuid
  building   Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  entranceId String?   @db.Uuid
  entrance   Entrance? @relation(fields: [entranceId], references: [id], onDelete: SetNull)
  label      String
  floor      Int? // 0 = EG
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([buildingId, label])
  @@index([buildingId])
  @@map("unit")
}

enum AccessScopeType {
  PROPERTY
  BUILDING
}

/// WP-1.3-Kern: reiner Datenmodell-Stub (ADR-004, Masterplan §4). Die
/// begünstigte Organisation (z. B. HV) erhält expliziten, auditierbaren
/// Teilbaum-Zugriff. Guard-Integration ist bewusst NICHT Teil dieses WP
/// (WP-1.3-Rest); bis dahin wertet kein Codepfad diese Tabelle aus.
/// DB-seitig (Migration access_scope_shape_constraints, raw SQL — in Prisma
/// nicht abbildbar): CHECK scopeType↔genau-ein-Ziel-FK + partielle
/// Unique-Indexe (organizationId, propertyId|buildingId).
model AccessScope {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id])
  scopeType      AccessScopeType
  propertyId     String?         @db.Uuid
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buildingId     String?         @db.Uuid
  building       Building?       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  grantedById    String? // User-ID (better-auth String-ID); im Stub bewusst ohne Relation
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@map("access_scope")
}
