{
  "name": "ph360-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm db:test:up && vitest run --project integration",
    "test:watch": "vitest",
    "db:test:up": "docker compose up -d --wait postgres",
    "db:generate": "pnpm --filter @ph360/database generate",
    "db:migrate": "pnpm --filter @ph360/database migrate",
    "db:migrate:deploy": "pnpm --filter @ph360/database migrate:deploy",
    "db:studio": "pnpm --filter @ph360/database studio",
    "db:seed": "pnpm --filter @ph360/database seed",
    "platform:dev": "pnpm --filter @ph360/platform dev",
    "website:dev": "pnpm --filter @ph360/website dev",
    "worker:dev": "pnpm --filter @ph360/worker dev",
    "ph360:create-admin": "tsx scripts/create-admin.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
